msgid "emails.reviewReminder.subject"
msgstr "Lembrete de Avaliação"

msgid "emails.reviewReminder.body"
msgstr ""
"Prezado(a) {$reviewerName},<br>\n"
"<br>\n"
"Você possui uma avaliação pendente na revista {$contextName}, para o artigo {$submissionTitle}.<br>\n"
"<br>\n"
"O prazo para avaliação é em {$reviewDueDate}. Você pode prosseguir com a avaliação através deste link:"
"<a href=\"{$reviewAssignmentUrl}\">Link para avaliação</a><br>\n"
"<br>\n"
"Você também pode utilizar o lembrete em anexo para adicionar esse evento ao calendário de sua preferência.<br>\n"

msgid "emails.reviewReminder.name"
msgstr "Lembrete de Avaliação"

msgid "emails.reviewReminder.description"
msgstr "Modelo de e-mail utilizado para notificar avaliadores sobre suas designações de avaliação"