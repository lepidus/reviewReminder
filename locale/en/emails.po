msgstr "Pending Reviews Reminder"

msgid "emails.pendingReviewsReminder.body"
msgstr ""
"Dear {$reviewerName},<br>\n"
"<br>\n"
"The manuscripts below are awaiting your review.<br/>\n"
"<br>\n"
"{$submissionsList}<br>\n"
"<br>\n"
"This is an automated email. If you have already submitted your review for these manuscripts, please disregard this email."
